# VaultLogic Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ============================================================================
# CORE CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=5000
BASE_URL=http://localhost:5000

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/vaultlogic

# Row-Level Security enforcement (SEC-051). Default off: RLS policies exist but are
# not enforced (see docs/architecture/TENANT_ISOLATION_RLS.md). Only set to "true"
# after the rollout's phase 2 adoption is complete AND the DB is in FORCE mode or
# the app connects as a non-owner role — otherwise tenant-scoped queries return no
# rows. Leave unset/false unless you are executing the RLS rollout.
# RLS_ENFORCED=false

# ============================================================================
# AUTHENTICATION & SECURITY (REQUIRED IN PRODUCTION)
# ============================================================================
# CRITICAL: Generate strong secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Session Secret (32+ characters)
SESSION_SECRET=your-session-secret-here-minimum-32-characters

# JWT Secret (32+ characters)
JWT_SECRET=your-jwt-secret-here-minimum-32-characters-long

# Master Encryption Key (base64-encoded 32-byte key)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
VL_MASTER_KEY=your-base64-master-key-here

# ============================================================================
# GOOGLE OAUTH2 (REQUIRED FOR AUTHENTICATION)
# ============================================================================
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Public self-registration is fail-closed. Set to true and redeploy when you
# are ready to send signup links to the account creation page again.
VITE_PUBLIC_SIGNUP_ENABLED=false

# DataVault API token management UI, fail-closed (DV-11). The token lifecycle is
# fully implemented but NO endpoint authenticates a DataVault token yet, so
# enabling this issues credentials that cannot be used. Leave false until the
# external DataVault API ships (backlog DV-B1).
VITE_ENABLE_DATAVAULT_API_TOKENS=false

# ============================================================================
# EMAIL (OPTIONAL - SendGrid)
# ============================================================================
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# ============================================================================
# AI SERVICES (OPTIONAL)
# ============================================================================
# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini Model Selection (default: gemini-2.0-flash)
# Available models: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-flash-lite, gemini-1.5-pro
# Note: Different models have different speeds, costs, and capabilities
GEMINI_MODEL=gemini-2.0-flash

# Alternative AI Providers (OpenAI/Anthropic)
AI_PROVIDER=openai
AI_API_KEY=your-openai-or-anthropic-api-key
AI_MODEL_WORKFLOW=gpt-4-turbo-preview

# AI abuse controls (per-tenant, SEC-038). Optional — defaults shown.
# AI_TENANT_RPM_LIMIT=20      # AI requests per tenant per minute
# AI_TENANT_DAILY_LIMIT=500   # AI requests per tenant per day

# Debug only: when true, AI response parse failures log raw content slices and
# write the full response to logs/ (may contain tenant data). Defaults off (SEC-039).
# AI_LOG_RAW_RESPONSES=false

# ============================================================================
# EXTERNAL APIS (OPTIONAL)
# ============================================================================
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# ============================================================================
# SLACK INTEGRATION (OPTIONAL)
# ============================================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=your-slack-channel-id

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
ALLOWED_ORIGIN=localhost,127.0.0.1

# ============================================================================
# FILE UPLOAD
# ============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================================================
# DOCUMENT STORAGE
# ============================================================================
# Where templates and generated documents live.
#   disk (default) - local filesystem under <cwd>/server/files. In production
#                    this MUST be a mounted persistent volume, or every template
#                    and generated document is lost on each deploy.
#   s3             - S3-compatible object storage (requires the AWS_* vars below)
STORAGE_DRIVER=disk

# Only used when STORAGE_DRIVER=s3. Works with any S3-compatible provider;
# setting AWS_S3_ENDPOINT switches the client to path-style addressing.
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_ENDPOINT=https://your-s3-compatible-endpoint
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ============================================================================
# DOCUMENT CONVERSION (DOCX -> PDF)
# ============================================================================
# Base URL of a Gotenberg service. When set, it is the primary converter and
# preserves headers, footers, numbering, fonts and section layout.
#
# When UNSET, conversion falls back to Mammoth -> HTML -> Puppeteer, which
# DISCARDS headers, footers, page/list numbering, table structure and section
# layout. That fallback is logged at error level and recorded per document in
# run_generated_documents.pdf_strategy; check GET /health for converter status.
# PDF_CONVERTER_API_URL=http://gotenberg.railway.internal:3000

# Conversion budget in ms. LibreOffice runs on large documents can be slow.
# PDF_CONVERTER_TIMEOUT_MS=60000

# ============================================================================
# MALWARE SCANNING (UPLOADS)
# ============================================================================
# Scanning is OFF by default (a no-op scanner that passes every file).
# WARNING: setting VIRUS_SCANNER_PROVIDER=clamav currently REJECTS EVERY UPLOAD
# because the ClamAV client is not implemented yet — do not enable it until it is.
# ENABLE_VIRUS_SCANNING=false
# VIRUS_SCANNER_PROVIDER=noop
# CLAMAV_HOST=localhost
# CLAMAV_PORT=3310

# ============================================================================
# DOCUMENT PROCESSING LIMITS
# ============================================================================
# Max concurrent heavy document operations (DOCX scan, PDF conversion).
# MAX_CONCURRENT_DOC_PROCESSES=2

# ZIP-bomb guards applied to every uploaded DOCX before it is parsed. A DOCX is
# a ZIP container, and the upload size limit only bounds the COMPRESSED bytes —
# a 10 MB upload can declare gigabytes of content. Both limits are read from the
# archive's central directory; nothing is inflated to measure it.
# Defaults are the values required by docs/hardening/docx-editor-gate.md.
# MAX_DOCX_UNCOMPRESSED_BYTES=268435456
# MAX_DOCX_COMPRESSION_RATIO=100

# ============================================================================
# STRIPE BILLING (OPTIONAL)
# ============================================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
